#!/bin/bash

# DNST / SSHPlus installer for Ubuntu 24.04 x86_64.
# The upstream modules remain functionally intact; menu display text is translated
# after installation and the original menu files are backed up first.

clear >/dev/null 2>&1 || true

if [[ "$(id -u)" -ne 0 ]]; then
    echo "Error: run this installer as root."
    exit 1
fi

if [[ ! -r /etc/os-release ]]; then
    echo "Error: cannot identify the operating system."
    exit 1
fi
. /etc/os-release
if [[ "${ID:-}" != "ubuntu" || "${VERSION_ID%%.*}" != "24" ]]; then
    echo "Error: this release is for Ubuntu 24.04 only. Detected: ${PRETTY_NAME:-unknown}."
    exit 1
fi
if [[ "$(uname -m)" != "x86_64" ]]; then
    echo "Error: this build requires x86_64. Detected: $(uname -m)."
    exit 1
fi

UPSTREAM_BASE='https://raw.githubusercontent.com/AAAAAEXQOSyIpN2JZ0ehUQ/SSHPLUS-MANAGER-FREE/master'
SLOWDNS_BINARY='https://raw.githubusercontent.com/powermx/dnstt/main/dns-server'
WORK_DIR='/usr/local/lib/sshplus-installer'
mkdir -p "$WORK_DIR" /etc/SSHPlus || {
    echo "Error: cannot create installer directories."
    exit 1
}
cd /root || exit 1

fetch_file() {
    local url="$1"
    local destination="$2"
    local temp="${destination}.tmp.$$"
    rm -f "$temp" 2>/dev/null || true
    if command -v curl >/dev/null 2>&1; then
        curl -fL --retry 3 --connect-timeout 10 --max-time 180 "$url" -o "$temp" >/dev/null 2>&1
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$temp" "$url" >/dev/null 2>&1
    else
        rm -f "$temp" 2>/dev/null || true
        return 1
    fi
    if [[ ! -s "$temp" ]]; then
        rm -f "$temp" 2>/dev/null || true
        return 1
    fi
    mv -f "$temp" "$destination"
}

install_packages() {
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y >/dev/null 2>&1 || return 1
    apt-get install -y \
        bc screen nano unzip lsof net-tools dos2unix nload jq curl wget \
        figlet python3 python3-pip iptables iptables-persistent cron \
        ca-certificates >/dev/null 2>&1 || return 1
    return 0
}

prepare_slowdns() {
    local dir='/etc/SSHPlus/dns'
    local binary="$dir/dns-server"
    mkdir -p "$dir" || return 1
    if ! fetch_file "$SLOWDNS_BINARY" "$binary"; then
        echo "Error: SlowDNS binary download failed."
        return 1
    fi
    chmod 755 "$binary" || return 1
    if [[ ! -s "$dir/server.key" || ! -s "$dir/server.pub" ]]; then
        rm -f "$dir/server.key" "$dir/server.pub" 2>/dev/null || true
        "$binary" -gen-key -privkey-file "$dir/server.key" -pubkey-file "$dir/server.pub" >/dev/null 2>&1 || true
    fi
    if [[ ! -s "$dir/server.key" || ! -s "$dir/server.pub" ]]; then
        echo "Error: SlowDNS key generation failed; server.pub was not created."
        return 1
    fi
    chmod 600 "$dir/server.key" 2>/dev/null || true
    chmod 644 "$dir/server.pub" 2>/dev/null || true
    return 0
}

install_upstream_modules() {
    local list="$WORK_DIR/list"
    if ! fetch_file "$UPSTREAM_BASE/Install/list" "$list"; then
        echo "Error: upstream module list download failed."
        return 1
    fi
    chmod 700 "$list"
    # The upstream list script is retained and executed to install its original modules.
    bash "$list" '/bin' "$WORK_DIR" "$WORK_DIR" '' >/dev/null 2>&1 || {
        echo "Error: upstream module installation failed."
        return 1
    }
    return 0
}

backup_and_translate_file() {
    local file="$1"
    local name
    [[ -f "$file" ]] || return 0
    name=$(basename "$file")
    cp -a "$file" "/etc/SSHPlus/original-${name}" 2>/dev/null || true

    # Only display strings are translated. Function names, menu numbers, URLs,
    # commands, paths, variables, and data are intentionally left unchanged.
    sed -i \
      -e 's|EXISTE UMA ATUALIZACAO DISPONIVEL|AN UPDATE IS AVAILABLE|g' \
      -e 's|REINICIAR SISTEMA|RESTART SYSTEM|g' \
      -e 's|REINICIAR SERVICOS|RESTART SERVICES|g' \
